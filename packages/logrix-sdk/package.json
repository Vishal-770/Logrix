{
  "name": "@logrix/sdk",
  "version": "0.8.1",
  "description": "Official CLI and AssemblyScript runtime library for Logrix blockchain indexers",
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "bin": {
    "logrix": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "default": "./index.ts"
    },
    "./as": "./index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./testing": "./src/testing/index.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');const f='dist/index.js';const c=fs.readFileSync(f,'utf8');if(!c.startsWith('#!/'))fs.writeFileSync(f,'#!/usr/bin/env node\\n'+c);\"",
    "test": "npm run build && node --test dist/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "src/runtime",
    "src/testing",
    "index.ts",
    "tsconfig.as.json",
    "README.md"
  ],
  "dependencies": {
    "@inquirer/prompts": "^5.3.8",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "yaml": "^2.4.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "assemblyscript": "^0.27.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vishal-770/Logrix.git",
    "directory": "packages/logrix-sdk"
  },
  "keywords": [
    "logrix",
    "indexer",
    "blockchain",
    "ethereum",
    "evm",
    "assemblyscript",
    "wasm",
    "graphql"
  ],
  "publishConfig": {
    "access": "public"
  }
}
