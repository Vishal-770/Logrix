# ==============================================================================
# Logrix Configuration Specification
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Target Chain & Ingestion Scope
# ------------------------------------------------------------------------------
CHAIN_ID=421614
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Secondary/Fallback EVM JSON-RPC endpoints (comma-separated)
# RPC_FALLBACK_URLS=https://arbitrum-sepolia.blockpi.network/v1/rpc/public,https://sepolia.arbitrum.io/rpc
# Compute Unit (CU) spending cap for historical backfills (gracefully pauses backfill when exhausted)
# CU_BUDGET=5000000
# Bulk stream archive endpoint override (e.g. SQD / HyperSync open data archive)
# BULK_STREAM_URL=https://v2.archive.subsquid.io/network/arbitrum-sepolia
CONTRACT_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
# Optional: Starting block. If omitted, starts from latest block - 50 or DB checkpoint.
# START_BLOCK=

# ------------------------------------------------------------------------------
# 2. Database Storage (PostgreSQL / AWS RDS / Aurora)
# ------------------------------------------------------------------------------
# Local dev: postgres://logrix:logrix@localhost:5432/logrix
# AWS RDS:   postgres://<user>:<password>@<rds-host>:5432/logrix?sslmode=verify-full
DATABASE_URL=postgres://logrix:logrix@localhost:5432/logrix

# ------------------------------------------------------------------------------
# 3. Message Queue Provider
# ------------------------------------------------------------------------------
# Driver: "rabbitmq" (AMQP) or "sqs" (AWS SQS)
QUEUE_DRIVER=rabbitmq

# --- RabbitMQ Settings (Used when QUEUE_DRIVER=rabbitmq) ---
# Local dev: amqp://logrix:logrix@localhost:5672
RABBITMQ_URL=amqp://logrix:logrix@localhost:5672

# --- AWS SQS Settings (Used when QUEUE_DRIVER=sqs) ---
# SQS_LIVE_URL=https://sqs.us-east-1.amazonaws.com/<account-id>/logrix-live-blocks
# SQS_BACKFILL_URL=https://sqs.us-east-1.amazonaws.com/<account-id>/logrix-backfill-blocks
# SQS_WEBHOOK_URL=https://sqs.us-east-1.amazonaws.com/<account-id>/logrix-webhooks
# SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/<account-id>/logrix-dlq
# SQS_ENDPOINT=http://localhost:4566 # Optional LocalStack override for local SQS testing

# ------------------------------------------------------------------------------
# 4. API & Observability
# ------------------------------------------------------------------------------
PORT=4000
RUST_LOG=info,logrix=debug
